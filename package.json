{
  "name": "poojly",
  "version": "0.1.0",
  "private": true,
  "description": "Poojly — India's devotional super-app platform",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.15.0",
    "prettier": "^3.5.3",
    "sharp": "^0.34.5",
    "turbo": "^2.4.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "protobufjs",
      "core-js",
      "msgpackr-extract"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

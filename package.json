{
  "name": "poojly",
  "version": "0.1.0",
  "private": true,
  "description": "Poojly — India's devotional super-app platform",
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev": "turbo dev",
    "build": "turbo build --filter=!@poojly/remotion-pitch",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:agent": "node scripts/test-agent-summary.mjs",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint:specs": "node scripts/lint-product-specs.mjs",
    "mcp:smoke": "pnpm --filter @darshya/mcp build && node scripts/mcp-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.4",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sharp": "^0.34.5",
    "turbo": "^2.4.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "protobufjs",
      "core-js",
      "msgpackr-extract"
    ],
    "overrides": {
      "uuid": "^14.0.0",
      "tar": "^7.5.11",
      "@xmldom/xmldom": "^0.8.13",
      "minimatch": "^10.2.3",
      "path-to-regexp": "^8.4.0",
      "esbuild": "^0.25.0",
      "cookie": "^2.0.1",
      "@opennextjs/aws>cookie": "^1.0.2",
      "ajv": "^8.18.0",
      "smol-toml": "^1.6.1",
      "srvx": "^0.11.13",
      "@tootallnate/once": "^3.0.1",
      "postcss": "^8.5.10",
      "undici": "^6.24.0",
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "js-yaml": "^4.2.0",
    "pg": "^8.21.0"
  }
}

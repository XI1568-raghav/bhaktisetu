# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
.turbo/
out/

# Environment
.env
.env.local
.env.*.local
*.bak-*

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude session junk (cmd-log, per-app .claude/)
.claude/cmd-log.jsonl
**/.claude/
# ...but keep the shareable Claude Code wiring (skills, settings, hooks, graft)
!.claude/
!.claude/settings.json
!.claude/skills/
!.claude/skills/**
!.claude/helpers/
!.claude/helpers/**
# ...but always drop per-session/runtime clutter even where .claude is re-included
.claude/format-log.jsonl
.claude/test-result.json
.claude/vitest-result.json
.claude/plans/
.claude/worktrees/

# OS
.DS_Store
Thumbs.db

# Testing
coverage/

# Prisma
apps/api/prisma/*.db

# Mobile
apps/mobile/.expo/
apps/mobile/ios/
apps/mobile/android/

# Medusa
apps/medusa-store/.cache/

# Misc
*.log
*.tsbuildinfo

# EAS build artifacts (mobile)
apps/mobile/build-log.txt
apps/mobile/build.json
apps/mobile/log*.txt
apps/mobile/log*.url
apps/mobile/log_url.txt

# Playwright test outputs (web)
apps/web/test-results/
apps/web/playwright-report/
apps/web/pitch-captures/

# Pitch reel intermediate artifacts (regenerable via stitch-pitch-video-v2.sh)
apps/web/scripts/build/
.worktrees/

# graft's local graph cache — regenerable, not committed (run `graft build`).
# anchored to repo root so it does NOT also match .claude/skills/graft/ (that skill is committed)
/graft/

# For Expo Go on a real phone: replace localhost with your machine's LAN IP.
# Find it with `ipconfig` (Windows) or `ifconfig | grep inet` (macOS/Linux).
# Phone running Expo Go must be on the same Wi-Fi network as this machine.
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

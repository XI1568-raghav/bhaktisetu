# Default points at the live deployed API on Render — works from any
# Expo Go device on any network without LAN setup.
EXPO_PUBLIC_API_URL=https://api.darshya.online

# For local development against `pnpm --filter @poojly/api dev`:
# Replace localhost with your machine's LAN IP (Windows: ipconfig).
# Phone must be on the same Wi-Fi as this machine.
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:4000

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

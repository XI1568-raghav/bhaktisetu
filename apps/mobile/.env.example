# Default points at the live deployed API on Render — works from any
# Expo Go device on any network without LAN setup.
EXPO_PUBLIC_API_URL=https://api.darshya.online

# For local development against `pnpm --filter @poojly/api dev`:
# Replace localhost with your machine's LAN IP (Windows: ipconfig).
# Phone must be on the same Wi-Fi as this machine.
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:4000

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Razorpay public/test key (rzp_test_* for preview, rzp_live_* for production)
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# PostHog product analytics (https://us.i.posthog.com or self-hosted)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry DSN for crash reporting (mobile-specific DSN, separate from web)
EXPO_PUBLIC_SENTRY_DSN=

# Feature flags (mirror web NEXT_PUBLIC_* gates). Set to "true" to enable.
EXPO_PUBLIC_KNOWLEDGE_ENABLED=false
EXPO_PUBLIC_GURUKUL_ENABLED=false

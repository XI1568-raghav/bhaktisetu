{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.darshya.online",
        "EXPO_PUBLIC_WEB_URL": "https://darshya.online",
        "EXPO_PUBLIC_KNOWLEDGE_ENABLED": "true"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      },
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.darshya.online",
        "EXPO_PUBLIC_WEB_URL": "https://darshya.online",
        "EXPO_PUBLIC_KNOWLEDGE_ENABLED": "true"
      }
    },
    "testflight": {
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "autoIncrement": "buildNumber"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.darshya.online",
        "EXPO_PUBLIC_WEB_URL": "https://darshya.online",
        "EXPO_PUBLIC_ENVIRONMENT": "testflight",
        "EXPO_PUBLIC_KNOWLEDGE_ENABLED": "true"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production"
      },
      "ios": {}
    }
  }
}

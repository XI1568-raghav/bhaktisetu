{
  "name": "@poojly/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "type-check": "tsc --noEmit",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android:dev": "eas build --profile development --platform android",
    "build:android:preview": "eas build --profile preview --platform android",
    "build:android:prod": "eas build --profile production --platform android",
    "build:ios:dev": "eas build --profile development --platform ios",
    "build:ios:prod": "eas build --profile production --platform ios",
    "build:all": "eas build --profile preview --platform all",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "prebuild": "expo prebuild"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "~14.0.4",
    "@poojly/api-client": "workspace:*",
    "@poojly/shared": "workspace:*",
    "@react-navigation/native": "^7.0.0",
    "@sentry/react-native": "^6.10.0",
    "@tanstack/react-query": "^5.74.4",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.0",
    "expo-constants": "~17.0.0",
    "expo-font": "~13.0.0",
    "expo-linking": "~7.0.0",
    "expo-modules-autolinking": "~2.0.0",
    "expo-notifications": "~0.14.0",
    "expo-modules-core": "~2.2.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.0",
    "expo-video": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "~0.76.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@poojly/tsconfig": "workspace:*",
    "@types/react": "^19.0.0",
    "typescript": "^5.8.3"
  }
}

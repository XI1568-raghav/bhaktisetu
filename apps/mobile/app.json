{
  "expo": {
    "name": "Darshya",
    "slug": "darshya",
    "version": "1.0.0",
    "scheme": "darshya",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#EA580C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.darshya.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EA580C"
      },
      "package": "com.darshya.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}

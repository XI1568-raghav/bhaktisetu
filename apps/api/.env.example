# Core (required) ────────────────────────────────────────────────
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://darshya.online

# AI (Groq) ──────────────────────────────────────────────────────
GROQ_API_KEY=

# Day 1 — Foundation ─────────────────────────────────────────────
SENTRY_DSN=
RESEND_API_KEY=
MAGIC_LINK_SECRET=

# Day 2 — Money/Audio ────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook HMAC mode. Default is on — raw-body HMAC, the path Razorpay
# documents. Set to "false" only to roll back to the legacy
# JSON.stringify(payload) compare while debugging a specific outage —
# see docs/razorpay-webhook-test.md.
RAZORPAY_VERIFY_RAW=true
# Object storage (Supabase Storage; module is still named lib/r2.ts for
# callsite stability). Reuses SUPABASE_SERVICE_ROLE_KEY above.
STORAGE_BUCKET=darshya-media

# Day 3 — Engagement ─────────────────────────────────────────────
# WhatsApp (parked — needs Meta business verification)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_OTP_TEMPLATE=otp_login

# Web push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@darshya.online

# Semantic search (Cohere)
COHERE_API_KEY=

# Cron (GitHub Actions hits the API)
CRON_AUTH_TOKEN=

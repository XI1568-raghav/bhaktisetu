// ─── Human-to-human chat (devotee ↔ provider) ────────────────────────────
// Backs the post-payment service-delivery flow: priest, astrologer, wellness
// instructor, temple manager, gaushala manager, store owner each get an inbox
// where they message and video-call devotees who paid for their service.

enum ChatConversationKind {
  puja_booking
  astrology
  wellness
  temple
  gaushala
  store_order
  support
}

enum ChatConversationStatus {
  open
  closed
}

enum ChatMessageKind {
  text
  system
  call_link
}

model ChatConversation {
  id              String                 @id @default(uuid()) @db.Uuid
  kind            ChatConversationKind
  status          ChatConversationStatus @default(open)
  devoteeId       String                 @map("devotee_id") @db.Uuid
  providerId      String                 @map("provider_id") @db.Uuid
  // Optional links — a chat may exist independent of a booking (e.g. support).
  linkedBookingId String?                @map("linked_booking_id") @db.Uuid
  subject         String?
  lastMessageAt   DateTime               @default(now()) @map("last_message_at")
  // Per-side unread counts — incremented on send, zeroed on read.
  devoteeUnread   Int                    @default(0) @map("devotee_unread")
  providerUnread  Int                    @default(0) @map("provider_unread")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  devotee  User              @relation("DevoteeChats", fields: [devoteeId], references: [id], onDelete: Cascade)
  provider User              @relation("ProviderChats", fields: [providerId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
  calls    ChatCallSession[]
  ratings  ServiceRating[]

  @@index([devoteeId, lastMessageAt])
  @@index([providerId, lastMessageAt])
  @@index([linkedBookingId])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String          @id @default(uuid()) @db.Uuid
  conversationId String          @map("conversation_id") @db.Uuid
  senderId       String          @map("sender_id") @db.Uuid
  kind           ChatMessageKind @default(text)
  body           String
  // Free-form metadata: { jitsiUrl?, callSessionId?, bookingNumber?, ... }
  metadata       Json?
  readAt         DateTime?       @map("read_at")
  createdAt      DateTime        @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model ChatCallSession {
  id              String    @id @default(uuid()) @db.Uuid
  conversationId  String    @map("conversation_id") @db.Uuid
  // Random 32-char unguessable Jitsi room name.
  roomName        String    @unique @map("room_name")
  jitsiUrl        String    @map("jitsi_url")
  startedById     String    @map("started_by_id") @db.Uuid
  startedAt       DateTime  @default(now()) @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationSeconds Int?      @map("duration_seconds")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  startedBy    User             @relation(fields: [startedById], references: [id], onDelete: Cascade)

  @@index([conversationId, startedAt])
  @@map("chat_call_sessions")
}

model ServiceRating {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  devoteeId      String   @map("devotee_id") @db.Uuid
  providerId     String   @map("provider_id") @db.Uuid
  // 1..5 inclusive. Validated at the route boundary; DB has no CHECK
  // because Prisma can't express it cleanly across providers, but the
  // Zod schema in routes/ratings.ts is the gate.
  stars          Int
  body           String?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  devotee      User             @relation("DevoteeRatings", fields: [devoteeId], references: [id], onDelete: Cascade)
  provider     User             @relation("ProviderRatings", fields: [providerId], references: [id], onDelete: Cascade)

  // One rating per devotee per conversation. A devotee can rate the
  // same provider again only via a different conversation (e.g. a new
  // booking → new conversation).
  @@unique([conversationId, devoteeId])
  @@index([providerId, createdAt])
  @@map("service_ratings")
}


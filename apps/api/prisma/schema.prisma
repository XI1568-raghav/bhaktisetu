// ─── SUPPORT TICKETS ───────────────────────────────────────────────────────

model SupportTicket {
  id           String                @id @default(uuid()) @db.Uuid
  ticketNumber String                @unique @map("ticket_number")
  userId       String                @map("user_id") @db.Uuid
  subject      String
  body         String
  category     SupportTicketCategory @default(OTHER)
  status       SupportTicketStatus   @default(OPEN)
  priority     SupportTicketPriority @default(MEDIUM)
  assignedToId String?               @map("assigned_to_id") @db.Uuid
  resolvedAt   DateTime?             @map("resolved_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  user       User                   @relation("SupportTicketUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo User?                  @relation("SupportTicketAssignee", fields: [assignedToId], references: [id])
  messages   SupportTicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  body       String
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

// ─── STORE ORDERS ──────────────────────────────────────────────────────────

model StoreOrder {
  id              String           @id @default(uuid()) @db.Uuid
  orderNumber     String           @unique @map("order_number")
  // P0 #S-08 (2026-07-09): client-generated idempotency key so a double-POST
  // (network retry, double-click past the disabled-button guard) returns the
  // existing order instead of creating a duplicate. Unique per user.
  idempotencyKey  String?          @map("idempotency_key")
  userId          String           @map("user_id") @db.Uuid
  // P0 #S-11 (2026-07-09): store attribution FK. Previously a StoreOrder had
  // no direct link to its StoreProfile — attribution was inferred from the
  // first line item's product, which breaks for mixed-store carts and makes
  // owner-scoped order queries impossible (see S-15). Set at checkout from the
  // product's store. Nullable + ON DELETE SET NULL so historical orders survive
  // a store-profile removal (receipt/tax traceability).
  storeProfileId  String?          @map("store_profile_id") @db.Uuid
  // items: [{ productId, qty, priceAtPurchase }]
  items           Json
  totalAmountInr  Decimal          @map("total_amount_inr") @db.Decimal(10, 2)
  status          StoreOrderStatus @default(PENDING)
  shippingAddress Json             @map("shipping_address")
  paymentId       String?          @map("payment_id") @db.Uuid
  trackingNumber  String?          @map("tracking_number")
  // statusHistory: [{ status, changedAt, changedBy, note }] — append-only audit log
  statusHistory   Json[]           @default([]) @map("status_history")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeProfile StoreProfile? @relation(fields: [storeProfileId], references: [id], onDelete: SetNull)
  payment     Payment?     @relation("StoreOrderPayment", fields: [paymentId], references: [id])

  @@index([userId])
  @@index([storeProfileId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  // P0 #S-08: dedupe double-POSTs within a user's checkout attempt.
  @@unique([userId, idempotencyKey])
  @@map("store_orders")
}

// ─── WELLNESS SESSIONS ─────────────────────────────────────────────────────

model WellnessSession {
  id              String                @id @default(uuid()) @db.Uuid
  instructorId    String                @map("instructor_id") @db.Uuid
  title           String
  description     String
  type            WellnessSessionType   @default(OTHER)
  scheduledAt     DateTime              @map("scheduled_at")
  durationMinutes Int                   @map("duration_minutes")
  capacity        Int
  priceInr        Decimal               @map("price_inr") @db.Decimal(10, 2)
  // Jitsi room URL — set by instructor; only visible to instructor + paid enrollees
  roomUrl         String?               @map("room_url")
  status          WellnessSessionStatus @default(SCHEDULED)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  instructor  User                 @relation("WellnessInstructor", fields: [instructorId], references: [id], onDelete: Cascade)
  enrollments WellnessEnrollment[]

  @@index([instructorId])
  @@index([scheduledAt])
  @@index([status])
  @@map("wellness_sessions")
}

model WellnessEnrollment {
  id              String                   @id @default(uuid()) @db.Uuid
  sessionId       String                   @map("session_id") @db.Uuid
  userId          String                   @map("user_id") @db.Uuid
  paymentId       String?                  @map("payment_id") @db.Uuid
  razorpayOrderId String?                  @map("razorpay_order_id")
  status          WellnessEnrollmentStatus @default(PENDING_PAYMENT)
  enrolledAt      DateTime                 @default(now()) @map("enrolled_at")
  attendedAt      DateTime?                @map("attended_at")

  session WellnessSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment?        @relation("WellnessEnrollmentPayment", fields: [paymentId], references: [id])

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([status])
  @@index([razorpayOrderId])
  @@map("wellness_enrollments")
}

// ─── LEAD GENERATION ───────────────────────────────────────────────────────
// Outreach pipeline: scraped provider candidates per role. Not connected to
// User/auth — these are prospects until converted (convertedUserId set).

enum LeadRole {
  TEMPLE
  PRIEST
  ASTROLOGER
  WELLNESS_INSTRUCTOR
  GAUSHALA
}

enum LeadStatus {
  NEW
  QUEUED
  EMAILED
  REPLIED
  CONVERTED
  BOUNCED
  UNSUBSCRIBED
}

model Lead {
  id              String     @id @default(uuid()) @db.Uuid
  role            LeadRole
  name            String
  city            String?
  state           String?
  country         String     @default("India")
  phone           String?
  email           String?
  whatsappNumber  String?    @map("whatsapp_number")
  source          String
  sourceUrl       String?    @map("source_url")
  metadata        Json       @default("{}")
  status          LeadStatus @default(NEW)
  lastContactedAt DateTime?  @map("last_contacted_at")
  contactCount    Int        @default(0) @map("contact_count")
  convertedUserId String?    @map("converted_user_id") @db.Uuid
  notes           String?
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  outreachLogs OutreachLog[]

  @@unique([role, email])
  @@unique([role, phone])
  @@index([role, status])
  @@index([city, role])
  @@map("leads")
}

enum OutreachChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum OutreachStatus {
  SENT
  DELIVERED
  OPENED
  REPLIED
  BOUNCED
  FAILED
}

model OutreachLog {
  id          String          @id @default(uuid()) @db.Uuid
  leadId      String          @map("lead_id") @db.Uuid
  channel     OutreachChannel
  templateKey String          @map("template_key")
  status      OutreachStatus
  payload     Json?
  errorMsg    String?         @map("error_msg")
  sentAt      DateTime        @default(now()) @map("sent_at")
  openedAt    DateTime?       @map("opened_at")
  clickedAt   DateTime?       @map("clicked_at")
  openCount   Int             @default(0) @map("open_count")
  clickCount  Int             @default(0) @map("click_count")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([status, sentAt])
  @@map("outreach_logs")
}

// ─── DEVOTEE WAITLIST ─────────────────────────────────────────────────────
// Pre-launch viral waitlist with referral codes. Devotees join, confirm via
// email, then climb the rank by sharing their unique referral URL.

model Waitlist {
  id             String         @id @default(uuid()) @db.Uuid
  email          String         @unique
  fullName       String?
  phone          String?
  city           String?
  preferredDeity String?
  panchangOptIn  Boolean        @default(true)
  whatsappOptIn  Boolean        @default(false)
  referralCode   String         @unique
  referredByCode String?
  referralCount  Int            @default(0)
  source         String?
  status         WaitlistStatus @default(PENDING)
  confirmedAt    DateTime?
  invitedAt      DateTime?
  convertedAt    DateTime?
  lastNudgedAt   DateTime?
  nudgeCount     Int            @default(0)
  createdAt      DateTime       @default(now())

  @@index([referralCode])
  @@index([referredByCode])
  @@index([status])
  @@map("waitlist")
}

enum WaitlistStatus {
  PENDING
  CONFIRMED
  INVITED
  CONVERTED
  UNSUBSCRIBED
}

// ─── CONTENT DRAFT QUEUE ──────────────────────────────────────────────────
// Layer O: Reddit/Quora content seed automation. Drafts generated by Groq
// and reviewed by admin before manual posting. type/status are TEXT (not
// Prisma enums) because the runtime falls back to raw SQL when this model
// hasn't been migrated, and string columns survive that path cleanly.

model ContentDraft {
  id             String    @id @default(uuid()) @db.Uuid
  type           String
  title          String
  body           String
  target         String
  status         String    @default("DRAFT")
  generatedAt    DateTime  @default(now()) @map("generated_at")
  approvedAt     DateTime? @map("approved_at")
  postedAt       DateTime? @map("posted_at")
  postedUrl      String?   @map("posted_url")
  rejectedReason String?   @map("rejected_reason")

  @@index([status, generatedAt])
  @@index([type])
  @@map("content_drafts")
}

// FCM device tokens for push notifications (mobile + web).
// One user can have many devices. `userId` is loosely typed (no FK) so a
// failed/legacy User row doesn't cascade-delete tokens; cleanup happens via
// the FCM "expired" feedback loop instead.
model FcmDeviceToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  deviceToken String   @unique @map("device_token")
  platform    String
  language    String?
  aartiOptIn  Boolean  @default(true) @map("aarti_opt_in")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("fcm_device_tokens")
}

// Devotee → temple follow. Drives "next aarti" reminders to subscribers of
// that specific temple (in addition to global aarti opt-in).
model TempleFollow {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  templeId  String   @map("temple_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, templeId])
  @@index([templeId])
  @@map("temple_follows")
}

// Kundli generation analytics. Stores a non-PII signature so we can dedupe
// repeat lookups without retaining raw birth details longer than necessary.
model KundliRequest {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  dob         DateTime @db.Date
  tob         String
  location    String
  signature   String
  generatedAt DateTime @default(now()) @map("generated_at")

  @@index([signature])
  @@index([userId])
  @@map("kundli_requests")
}


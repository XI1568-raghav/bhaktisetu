  slug            String   @unique
  name            String
  description     String
  city            String
  state           String
  country         String   @default("IN")
  websiteUrl      String?  @map("website_url")
  contactEmail    String   @map("contact_email")
  contactVerified Boolean  @default(false) @map("contact_verified")
  contactPhone    String?  @map("contact_phone")
  tradition       String
  isResidential   Boolean  @default(false) @map("is_residential")
  isOnline        Boolean  @default(false) @map("is_online")

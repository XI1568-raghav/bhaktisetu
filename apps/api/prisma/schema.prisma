enum UserRole {
  DEVOTEE
  PANDIT
  STORE_OWNER
  ASTROLOGER
  WELLNESS_INSTRUCTOR
  GAUSHALA_MANAGER
  TEMPLE_MANAGER
  ADMIN
}

enum MarketplacePlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum MarketplaceSubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum CommissionStatus {
  PENDING
  PAID
  // RV-02 (2026-08-10): a refunded booking must be able to UNWIND the provider's
  // earning. Before this there was no terminal state other than PAID, so a
  // Commission minted at confirm-time stayed PENDING and fully withdrawable even
  // after the devotee was refunded — the platform paid out on a booking that
  // earned Rs 0. REVERSED is set by the refund path and is excluded from every
  // payout-balance query. Additive only: no existing row changes meaning.
  REVERSED
}

// Provider payouts (unified across all roles) — cross-cutting Phase 2 (2026-08-06)
enum PayoutRequestStatus {
  pending
  processing
  completed
  failed
  rejected
}

enum ProviderRole {
  PANDIT
  ASTROLOGER
  WELLNESS_INSTRUCTOR
  STORE_OWNER
  TEMPLE_MANAGER
  GAUSHALA_MANAGER
}

enum ProviderPayoutStatus {
  pending
  processing
  completed
  failed
  // RV-02 (2026-08-10): mirrors CommissionStatus.REVERSED. A refunded booking
  // must unwind the temple's 5% share too — otherwise TemplePayout stays
  // `pending` and payable on a booking that earned Rs 0. Additive only.
  reversed
}

enum TransactionType {
  BOOKING
  SUBSCRIPTION
  PAYOUT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ProviderType {
  PANDIT
  STORE
  ASTROLOGER
  WELLNESS
  GAUSHALA
  TEMPLE
}


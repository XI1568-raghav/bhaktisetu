generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ─────────────────────────────────────────────────────────────────────

enum Language {
  en
  hi
  ta
  te
  bn
  mr
  gu
  kn
  ml
  pa
}

enum SubscriptionTier {
  free
  bhakti_pass
  premium
}

enum Tradition {
  shaiva
  vaishnava
  shakta
  smarta
  jain
  sikh
  buddhist
  other
}

enum TempleStatus {
  active
  inactive
  pending_review
}

enum PriestVerificationStatus {
  pending
  approved
  rejected
}

enum PriestStatus {
  active
  inactive
  suspended
}

enum PriestTier {
  instant_pool
  verified
  senior
  standard
}

enum DispatchTier {
  instant
  one_hour
  senior
  scheduled
}

enum OfferState {
  sent
  accepted
  declined
  expired
  superseded
}

enum PujaCategory {
  daily
  special_occasion
  planetary
  prosperity
  health
  memorial
  festival
}

enum BookingStatus {
  pending_payment
  confirmed
  priest_assigned
  in_progress
  completed
  video_uploaded
  delivered
  cancelled
  refunded
}

enum PaymentGateway {
  razorpay
  stripe
  phonepe
}

enum PaymentStatus {
  initiated
  authorized
  captured
  failed
  refunded
  partially_refunded
}

enum PayoutStatus {
  pending
  processing
  completed
  failed
}

enum ContentType {
  aarti
  chalisa
  mantra
  bhajan
  story
  article
  shloka
  video_reel
}

enum ContentStatus {
  draft
  published
  archived
}

enum StreamStatus {
  offline
  live
  scheduled
}

enum StreamProvider {
  YOUTUBE
  IVS
  EXTERNAL_RTMP
}

enum SubscriptionPlan {
  bhakti_pass_monthly
  bhakti_pass_yearly
  nri_premium_monthly
  nri_premium_yearly
}

enum SubscriptionStatus {
  active
  cancelled
  expired
  past_due
}

// ─── MODELS ────────────────────────────────────────────────────────────────────

model User {
  id                String           @id @default(uuid()) @db.Uuid
  phone             String?          @unique
  email             String?          @unique
  fullName          String           @map("full_name")
  avatarUrl         String?          @map("avatar_url")
  preferredLanguage Language         @default(hi) @map("preferred_language")
  locationCity      String?          @map("location_city")
  locationState     String?          @map("location_state")
  isNri             Boolean          @default(false) @map("is_nri")
  nriCountry        String?          @map("nri_country")
  gotra             String?
  nakshatra         String?
  rashi             String?
  subscriptionTier  SubscriptionTier @default(free) @map("subscription_tier")
  blocked           Boolean          @default(false)
  blockedReason     String?          @map("blocked_reason")
  blockedAt         DateTime?        @map("blocked_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  addresses       UserAddress[]
  bookings        PujaBooking[]
  payments        Payment[]
  subscription    Subscription[]
  priest          Priest?
  conversations   AiConversation[]
  // Human-to-human chat (devotee ↔ provider) — see ChatConversation below.
  // Two relations because a conversation has two distinct participant slots
  // (devotee + provider); Prisma needs named relations to disambiguate.
  chatAsDevotee   ChatConversation[] @relation("DevoteeChats")
  chatAsProvider  ChatConversation[] @relation("ProviderChats")
  chatMessages    ChatMessage[]
  chatCallStarts  ChatCallSession[]
  ratingsGiven    ServiceRating[]    @relation("DevoteeRatings")
  ratingsReceived ServiceRating[]    @relation("ProviderRatings")
  donations       Donation[]
  pushSubscriptions PushSubscription[]

  // Support tickets
  supportTickets         SupportTicket[]        @relation("SupportTicketUser")
  supportTicketsAssigned SupportTicket[]        @relation("SupportTicketAssignee")
  supportTicketMessages  SupportTicketMessage[]

  // Store orders
  storeOrders StoreOrder[]

  // Wellness sessions
  wellnessSessionsHosted WellnessSession[]    @relation("WellnessInstructor")
  wellnessEnrollments    WellnessEnrollment[]

  // Books reader
  readingProgress ReadingProgress[]

  // Sanskrit lessons + gurukul marketplace (added 2026-05-21)
  lessonProgress       UserLessonProgress[]
  streak               UserStreak?
  badges               UserBadge[]
  ownedGurukuls        Gurukul[]            @relation("GurukulOwner")
  gurukulApplications  GurukulApplication[]

  // Referral system (added 2026-05-27) — one shareable code per user; multiple
  // claims tracked per outbound + inbound side.
  referralCode         ReferralCode?
  referralsMade        ReferralClaim[]      @relation("ReferralReferrer")
  referralsClaimed     ReferralClaim[]      @relation("ReferralReferee")

  // Wallet (added 2026-06-12 for R-Q2-M-011 referral reward sink)
  credit               UserCredit?
  creditLedgerEntries  CreditLedgerEntry[]

  @@map("users")
}

model UserAddress {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  label     String  @default("home")
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String  @default("India")
  isDefault Boolean @default(false) @map("is_default")
  lat       Float?
  lng       Float?

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings PujaBooking[]

  @@index([userId])
  @@map("user_addresses")
}

model Temple {
  id                 String                       @id @default(uuid()) @db.Uuid
  name               String
  nameLocal          String?                      @map("name_local")
  slug               String                       @unique
  description        String
  deityPrimary       String                       @map("deity_primary")
  deities            String[]
  tradition          Tradition                    @default(other)
  addressLine        String                       @map("address_line")
  city               String
  state              String
  pincode            String
  country            String                       @default("India")
  lat                Float
  lng                Float
  phone              String?
  email              String?
  websiteUrl         String?                      @map("website_url")
  images             Json                         @default("[]")
  timingInfo         Json?                        @map("timing_info")
  isVerified         Boolean                      @default(false) @map("is_verified")
  verificationDate   DateTime?                    @map("verification_date")
  trustScore         Float                        @default(0) @map("trust_score")
  liveDarshanEnabled Boolean                      @default(false) @map("live_darshan_enabled")
  streamUrl          String?                      @map("stream_url")
  status             TempleStatus                 @default(pending_review)
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")
  embedding          Unsupported("vector(1024)")?

  priests       TemplePriest[]
  pujaOfferings TemplePujaOffering[]
  bookings      PujaBooking[]
  darshanStream LiveDarshanStream[]
  donations     Donation[]
  templePayouts TemplePayout[]

  @@index([slug])
  @@index([city])
  @@index([state])
  @@index([isVerified])
  @@index([city, state, status])
  @@map("temples")
}

model Priest {
  id                 String                   @id @default(uuid()) @db.Uuid
  userId             String                   @unique @map("user_id") @db.Uuid
  displayName        String                   @map("display_name")
  specializations    String[]
  languages          String[]
  experienceYears    Int                      @map("experience_years")
  aadhaarVerified    Boolean                  @default(false) @map("aadhaar_verified")
  certificationDocs  Json?                    @map("certification_docs")
  ratingAvg          Float                    @default(0) @map("rating_avg")
  ratingCount        Int                      @default(0) @map("rating_count")
  isVerified         Boolean                  @default(false) @map("is_verified")
  verificationStatus PriestVerificationStatus @default(pending) @map("verification_status")
  bio                String?
  avatarUrl          String?                  @map("avatar_url")
  commissionRate     Float                    @default(0.70) @map("commission_rate")
  status             PriestStatus             @default(active)
  tier                 PriestTier             @default(standard)
  isOnDuty             Boolean                @default(false) @map("is_on_duty")
  lastSeenAt           DateTime?              @map("last_seen_at")
  lat                  Float?
  lng                  Float?
  city                 String?
  serviceRadiusKm      Int                    @default(15) @map("service_radius_km")
  acceptanceRate       Float                  @default(1.0) @map("acceptance_rate")
  responseSlaSec       Int                    @default(60) @map("response_sla_sec")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  temples              TemplePriest[]
  bookings             PujaBooking[]
  payouts              PriestPayout[]
  offerings            PriestPujaOffering[]
  assignedTemplePujas  TemplePujaOffering[] @relation("AssignedTemplePujas")
  dispatchOffers       DispatchOffer[]

  @@map("priests")
}

// Pandit-owned puja offerings — a separate catalog from PujaType. Each
// row is authored by a single Priest and surfaced on their public
// profile. Bookings against these offerings are out of scope for the
// initial cut; the existing PujaBooking model still requires templeId
// and points at temple-anchored PujaType rows.
model PriestPujaOffering {
  id                 String   @id @default(uuid()) @db.Uuid
  priestId           String   @map("priest_id") @db.Uuid
  name               String
  description        String?
  deity              String
  basePrice          Decimal  @map("base_price") @db.Decimal(10, 2)
  durationMinutes    Int      @map("duration_minutes")
  isActive           Boolean  @default(true) @map("is_active")
  // Slot capacity model (mirrors TemplePujaOffering). Defaults to 1 so
  // priest catalogs stay strict (one devotee per slot) until configured.
  maxBookingsPerSlot Int      @default(1) @map("max_bookings_per_slot")
  // Free-form slot list. Same shape as TemplePujaOffering.availableSlots —
  // either an array of "HH:MM" strings or {time,label} objects.
  availableSlots     Json?    @map("available_slots")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  priest   Priest        @relation(fields: [priestId], references: [id], onDelete: Cascade)
  bookings PujaBooking[]

  @@index([priestId])
  @@index([isActive])
  @@map("priest_puja_offerings")
}

model TemplePriest {
  id        String   @id @default(uuid()) @db.Uuid
  templeId  String   @map("temple_id") @db.Uuid
  priestId  String   @map("priest_id") @db.Uuid
  isPrimary Boolean  @default(false) @map("is_primary")
  joinedAt  DateTime @default(now()) @map("joined_at")

  temple Temple @relation(fields: [templeId], references: [id], onDelete: Cascade)
  priest Priest @relation(fields: [priestId], references: [id], onDelete: Cascade)

  @@unique([templeId, priestId])
  @@map("temple_priests")
}

model PujaType {
  id                  String                       @id @default(uuid()) @db.Uuid
  name                String
  nameLocal           String?                      @map("name_local")
  slug                String                       @unique
  description         String
  category            PujaCategory
  deity               String
  durationMinutes     Int                          @map("duration_minutes")
  basePrice           Decimal                      @map("base_price") @db.Decimal(10, 2)
  nriPrice            Decimal                      @map("nri_price") @db.Decimal(10, 2)
  samagriIncluded     Boolean                      @default(true) @map("samagri_included")
  samagriItems        Json?                        @map("samagri_items")
  images              Json                         @default("[]")
  videoProofMandatory Boolean                      @default(true) @map("video_proof_mandatory")
  isActive            Boolean                      @default(true) @map("is_active")
  sortOrder           Int                          @default(0) @map("sort_order")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")
  embedding           Unsupported("vector(1024)")?

  templeOfferings TemplePujaOffering[]
  bookings        PujaBooking[]

  @@index([slug])
  @@index([category])
  @@index([isActive])
  @@map("puja_types")
}

model TemplePujaOffering {
  id                 String   @id @default(uuid()) @db.Uuid
  templeId           String   @map("temple_id") @db.Uuid
  pujaTypeId         String   @map("puja_type_id") @db.Uuid
  priceOverride      Decimal? @map("price_override") @db.Decimal(10, 2)
  // Temple manager–set NRI price override. When null the public puja
  // detail falls back to PujaType.nriPrice (business rule #2: 9-10× INR).
  nriPrice           Decimal? @map("nri_price") @db.Decimal(10, 2)
  // Temple manager pins a specific priest to this puja offering. SET NULL
  // on priest deletion so the offering survives staff turnover.
  assignedPriestId   String?  @map("assigned_priest_id") @db.Uuid
  availableSlots     Json     @default("[]") @map("available_slots")
  maxBookingsPerSlot Int      @default(5) @map("max_bookings_per_slot")
  isActive           Boolean  @default(true) @map("is_active")

  temple         Temple        @relation(fields: [templeId], references: [id], onDelete: Cascade)
  pujaType       PujaType      @relation(fields: [pujaTypeId], references: [id], onDelete: Cascade)
  assignedPriest Priest?       @relation("AssignedTemplePujas", fields: [assignedPriestId], references: [id], onDelete: SetNull)
  bookings       PujaBooking[]

  @@unique([templeId, pujaTypeId])
  @@index([assignedPriestId])
  @@map("temple_puja_offerings")
}

model PujaBooking {
  id                      String        @id @default(uuid()) @db.Uuid
  bookingNumber           String        @unique @map("booking_number")
  userId                  String        @map("user_id") @db.Uuid
  templeId                String        @map("temple_id") @db.Uuid
  pujaTypeId              String        @map("puja_type_id") @db.Uuid
  priestId                String?       @map("priest_id") @db.Uuid
  templePujaOfferingId    String        @map("temple_puja_offering_id") @db.Uuid
  // Set when the booking originated from POST /bookings/from-offering
  // (pandit-direct catalog). Null for regular temple-anchored bookings.
  // SET NULL on offering delete so booking history survives.
  priestPujaOfferingId    String?       @map("priest_puja_offering_id") @db.Uuid
  scheduledDate           DateTime      @map("scheduled_date") @db.Date
  scheduledTimeSlot       String        @map("scheduled_time_slot")
  devoteeNames            Json          @map("devotee_names")
  sankalpDetails          String?       @map("sankalp_details")
  specialInstructions     String?       @map("special_instructions")
  priceAmount             Decimal       @map("price_amount") @db.Decimal(10, 2)
  currency                String        @default("INR")
  platformCommission      Decimal       @map("platform_commission") @db.Decimal(10, 2)
  priestPayout            Decimal       @map("priest_payout") @db.Decimal(10, 2)
  status                  BookingStatus @default(pending_payment)
  videoProofUrl           String?       @map("video_proof_url")
  videoUploadedAt         DateTime?     @map("video_uploaded_at")
  prasadDeliveryRequested Boolean       @default(false) @map("prasad_delivery_requested")
  prasadDeliveryAddressId String?       @map("prasad_delivery_address_id") @db.Uuid
  prasadTrackingId        String?       @map("prasad_tracking_id")
  rating                  Int?
  reviewText              String?       @map("review_text")
  cancelledAt             DateTime?     @map("cancelled_at")
  cancellationReason      String?       @map("cancellation_reason")
  dispatchTier            DispatchTier  @default(scheduled) @map("dispatch_tier")
  offerExpiresAt          DateTime?     @map("offer_expires_at")
  assignedVia             String?       @map("assigned_via")
  rescheduleCount         Int           @default(0) @map("reschedule_count")
  cancelPolicyJson        Json?         @map("cancel_policy_json")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id])
  temple             Temple              @relation(fields: [templeId], references: [id])
  pujaType           PujaType            @relation(fields: [pujaTypeId], references: [id])
  priest             Priest?             @relation(fields: [priestId], references: [id])
  templePujaOffering TemplePujaOffering  @relation(fields: [templePujaOfferingId], references: [id])
  priestPujaOffering PriestPujaOffering? @relation(fields: [priestPujaOfferingId], references: [id], onDelete: SetNull)
  prasadAddress      UserAddress?        @relation(fields: [prasadDeliveryAddressId], references: [id])
  payments           Payment[]
  priestPayouts      PriestPayout[]
  templePayouts      TemplePayout[]
  dispatchOffers     DispatchOffer[]

  @@index([userId])
  @@index([templeId])
  @@index([status])
  @@index([scheduledDate])
  @@index([templeId, scheduledDate, status])
  @@index([priestPujaOfferingId])
  // RV-20 (2026-08-10): priest_id is the SOLE predicate of the entire pandit
  // portal (my-bookings, earnings, dispatch) and was unindexed — every pandit
  // page did a full scan of puja_bookings.
  @@index([priestId])
  @@index([dispatchTier, status])
  @@map("puja_bookings")
}

model DispatchOffer {
  id          String     @id @default(uuid()) @db.Uuid
  bookingId   String     @map("booking_id") @db.Uuid
  priestId    String     @map("priest_id") @db.Uuid
  state       OfferState @default(sent)
  sentAt      DateTime   @default(now()) @map("sent_at")
  respondedAt DateTime?  @map("responded_at")
  expiresAt   DateTime   @map("expires_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  booking PujaBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  priest  Priest      @relation(fields: [priestId], references: [id], onDelete: Cascade)

  @@index([bookingId, state])
  @@index([priestId, state])
  @@index([state, expiresAt])
  @@map("dispatch_offers")
}

// The temple administration's share of a puja booking (cross-cutting Phase 2,
// 2026-08-06). Before this, a puja's price split only into priest (80%) +
// platform (20%) — the TEMPLE got nothing, which is the Harvard-documented
// "donation bypass" grievance: platforms pay the priest directly and cut out
// the temple administration. TemplePayout records the temple's cut per booking
// so it can be settled to the temple trust like any provider payout.
model TemplePayout {
  id          String               @id @default(uuid()) @db.Uuid
  templeId    String               @map("temple_id") @db.Uuid
  bookingId   String               @map("booking_id") @db.Uuid
  amount      Decimal              @db.Decimal(10, 2)
  status      ProviderPayoutStatus @default(pending)
  reference   String?
  processedAt DateTime?            @map("processed_at")
  createdAt   DateTime             @default(now()) @map("created_at")

  temple  Temple      @relation(fields: [templeId], references: [id])
  booking PujaBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([templeId, status])
  @@index([status])
  @@map("temple_payouts")
}

// A devotee's web-push subscription, persisted (cross-cutting Phase 2). Before
// this, push subs lived in an in-memory Map lost on every restart — so the
// daily panchang blast (master-cron tickPanchangBlast) no-opped with "no push
// subscription model". Persisting them enables the daily panchang + streak
// push that drives the devotional daily-open habit.
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  // Opt-in to the daily panchang push (5am IST). Default true on subscribe so
  // the panchang blast has an audience; the devotee can opt out.
  panchangOptIn Boolean @default(true) @map("panchang_opt_in")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([panchangOptIn])
  @@map("push_subscriptions")
}

model Payment {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  bookingId        String?        @map("booking_id") @db.Uuid
  orderId          String?        @map("order_id")
  amount           Decimal        @db.Decimal(10, 2)
  currency         String         @default("INR")
  paymentGateway   PaymentGateway @map("payment_gateway")
  gatewayPaymentId String?        @map("gateway_payment_id")
  gatewayOrderId   String?        @map("gateway_order_id")
  status           PaymentStatus  @default(initiated)
  method           String?
  refundAmount     Decimal?       @map("refund_amount") @db.Decimal(10, 2)
  metadata         Json?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  user    User         @relation(fields: [userId], references: [id])
  // P1-11: onDelete SetNull — bookingId is nullable, so a deleted booking keeps
  // its Payment rows (refund/audit history must survive even if the booking is
  // purged). Previously Restrict (Prisma default), which blocked booking deletes
  // that orphaned no real data.
  booking PujaBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  storeOrders         StoreOrder[]         @relation("StoreOrderPayment")
  wellnessEnrollments WellnessEnrollment[] @relation("WellnessEnrollmentPayment")

  @@index([gatewayPaymentId])
  @@index([userId])
  @@index([status])
  @@map("payments")
}

model PriestPayout {
  id              String       @id @default(uuid()) @db.Uuid
  priestId        String       @map("priest_id") @db.Uuid
  bookingId       String       @map("booking_id") @db.Uuid
  amount          Decimal      @db.Decimal(10, 2)
  status          PayoutStatus @default(pending)
  payoutMethod    String       @map("payout_method")
  payoutReference String?      @map("payout_reference")
  processedAt     DateTime?    @map("processed_at")
  createdAt       DateTime     @default(now()) @map("created_at")

  priest  Priest      @relation(fields: [priestId], references: [id])
  // P1-11: onDelete Cascade — bookingId is NON-nullable, so SetNull is illegal
  // (a payout can't exist without its booking). Cascade means deleting a booking
  // removes its pending payout rows; a paid-out booking shouldn't be deleted
  // anyway, and an orphaned payout row would be unreconcilable. This is the
  // correct behavior for a non-nullable dependent FK.
  booking PujaBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([priestId])
  @@index([status])
  @@map("priest_payouts")
}

model ContentItem {
  id              String                       @id @default(uuid()) @db.Uuid
  type            ContentType
  title           String
  titleLocal      String?                      @map("title_local")
  slug            String                       @unique
  body            String
  audioUrl        String?                      @map("audio_url")
  videoUrl        String?                      @map("video_url")
  imageUrl        String?                      @map("image_url")
  deity           String?
  language        Language                     @default(hi)
  durationSeconds Int?                         @map("duration_seconds")
  tags            String[]
  isPremium       Boolean                      @default(false) @map("is_premium")
  viewCount       Int                          @default(0) @map("view_count")
  likeCount       Int                          @default(0) @map("like_count")
  sortOrder       Int                          @default(0) @map("sort_order")
  status          ContentStatus                @default(draft)
  publishedAt     DateTime?                    @map("published_at")
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")
  embedding       Unsupported("vector(1024)")?

  @@index([slug])
  @@index([type])
  @@index([deity])
  @@index([language])
  @@index([status])
  @@map("content_items")
}

model DailyPanchang {
  id           String   @id @default(uuid()) @db.Uuid
  date         DateTime @unique @db.Date
  tithi        String
  nakshatra    String
  yoga         String
  karana       String
  sunrise      String
  sunset       String
  rahuKaal     String   @map("rahu_kaal")
  shubhMuhurat Json     @map("shubh_muhurat")
  festivals    String[]
  vrat         String[]
  specialInfo  String?  @map("special_info")
  locationCity String   @default("Delhi") @map("location_city")

  @@index([date, locationCity])
  @@map("daily_panchang")
}

model LiveDarshanStream {
  id               String         @id @default(uuid()) @db.Uuid

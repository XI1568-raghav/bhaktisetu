model Donation {
  id                String         @id
  userId            String         @map("user_id") @db.Uuid
  // Polymorphic donee. Exactly one of (gaushalaId, templeId) is non-null
  // per row (enforced at the app layer, not the DB — see migration
  // 20260520020000 for the rationale).
  //
  // gaushalaId is a stringified gaushala_profiles.user_id (no FK — see
  // schema note above; gaushalas may be deleted while donation history
  // must remain for tax-receipt traceability). templeId is a real UUID
  // FK on temples(id) with ON DELETE SET NULL so receipts survive temple
  // removal.
  gaushalaId        String?        @map("gaushala_id")
  templeId          String?        @map("temple_id") @db.Uuid
  amountInr         Decimal        @map("amount_inr") @db.Decimal(10, 2)
  razorpayOrderId   String         @unique @map("razorpay_order_id")
  razorpayPaymentId String?        @map("razorpay_payment_id")
  receiptNumber     String?        @unique @map("receipt_number")
  status            DonationStatus @default(created)
  // P0 #PBO-14 (2026-07-09): donor PAN (required ≥ ₹2,000 for 80G) + the
  // optional dedication message. Collected by DonationForm but previously
  // dropped before persistence, so the 80G receipt omitted the donor PAN.
  donorPan          String?        @map("donor_pan")
  dedication        String?        @map("dedication")
  createdAt         DateTime       @default(now()) @map("created_at")
  paidAt            DateTime?      @map("paid_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  temple Temple? @relation(fields: [templeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([gaushalaId, createdAt])
  @@index([templeId, createdAt])
  @@map("donations")
}

// ─── GAUSHALA CRUD: COWS + VOLUNTEERS + HEALTH ─────────────────────────────

model Cow {
  id           String   @id @default(uuid()) @db.Uuid

{
  "name": "@poojly/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "tsx scripts/guard-db-target.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "prisma migrate deploy && node dist/server.js",
    "lint": "echo \"lint: ok\"",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "predb:migrate": "tsx scripts/guard-db-target.ts",
    "db:migrate": "prisma migrate dev",
    "predb:push": "tsx scripts/guard-db-target.ts",
    "db:push": "prisma db push",
    "predb:studio": "tsx scripts/guard-db-target.ts",
    "db:studio": "prisma studio",
    "predb:seed": "tsx scripts/guard-db-target.ts",
    "db:seed": "tsx prisma/seed.ts",
    "preseed:darshan": "tsx scripts/guard-db-target.ts",
    "seed:darshan": "tsx prisma/seed/darshan-streams.ts",
    "test": "vitest run",
    "leads:scrape-temples": "tsx scripts/leads/scrape-temples.ts",
    "leads:scrape-priests": "tsx scripts/leads/scrape-priests.ts",
    "leads:scrape-astrologers": "tsx scripts/leads/scrape-astrologers.ts",
    "leads:scrape-wellness": "tsx scripts/leads/scrape-wellness.ts",
    "leads:scrape-gaushalas": "tsx scripts/leads/scrape-gaushalas.ts",
    "leads:scrape-all": "pnpm run \"/^leads:scrape-(temples|priests|astrologers|wellness|gaushalas)$/\" --parallel"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/s3-request-presigner": "^3.1037.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.1",
    "@poojly/shared": "workspace:*",
    "@prisma/client": "^6.6.0",
    "@sentry/node": "^10.50.0",
    "@supabase/supabase-js": "^2.49.4",
    "bullmq": "^5.45.2",
    "cheerio": "^1.2.0",
    "cookie": "^2.0.1",
    "fastify": "^5.3.2",
    "fastify-raw-body": "^5.0.0",
    "ioredis": "^5.6.1",
    "pdf-lib": "^1.17.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "razorpay": "^2.9.5",
    "resend": "^6.12.2",
    "web-push": "^3.6.7",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@poojly/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "prisma": "^6.6.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}

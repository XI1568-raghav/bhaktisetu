{
  "name": "@poojly/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@poojly/shared": "workspace:*",
    "@prisma/client": "^6.6.0",
    "@supabase/supabase-js": "^2.49.4",
    "fastify": "^5.3.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/multipart": "^9.0.3",
    "zod": "^3.24.4",
    "razorpay": "^2.9.5",
    "ioredis": "^5.6.1",
    "bullmq": "^5.45.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@poojly/tsconfig": "workspace:*",
    "prisma": "^6.6.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "@types/node": "^22.15.0",
    "vitest": "^3.1.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}

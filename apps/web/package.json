{
  "name": "@poojly/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "pages:build": "npx @cloudflare/next-on-pages",
    "pages:deploy": "pnpm run pages:build && wrangler pages deploy .vercel/output/static --project-name=poojly-web",
    "pages:dev": "wrangler pages dev .vercel/output/static"
  },
  "dependencies": {
    "@poojly/analytics": "workspace:*",
    "@poojly/api-client": "workspace:*",
    "@poojly/shared": "workspace:*",
    "@poojly/ui": "workspace:*",
    "@supabase/supabase-js": "^2.49.4",
    "@tailwindcss/postcss": "^4.1.4",
    "@tanstack/react-query": "^5.74.4",
    "lucide-react": "^0.503.0",
    "next": "^15.5.2",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.4"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@playwright/test": "^1.59.1",
    "@poojly/tsconfig": "workspace:*",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "typescript": "^5.8.3",
    "vercel": "^51.8.0",
    "wrangler": "^4.84.0"
  }
}

{
  "name": "@poojly/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:turbo": "next dev --turbopack --port 3000",
    "prebuild": "node scripts/build-search-index.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "echo \"lint: ok\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "pages:build": "npx @cloudflare/next-on-pages",
    "pages:deploy": "pnpm run pages:build && wrangler pages deploy .vercel/output/static --project-name=darshya",
    "pages:dev": "wrangler pages dev .vercel/output/static"
  },
  "dependencies": {
    "@poojly/api-client": "workspace:*",
    "@poojly/shared": "workspace:*",
    "@poojly/ui": "workspace:*",
    "@stripe/react-stripe-js": "^2.9.0",
    "@stripe/stripe-js": "^4.10.0",
    "@supabase/supabase-js": "^2.49.4",
    "@tailwindcss/postcss": "^4.1.4",
    "@tanstack/react-query": "^5.74.4",
    "lucide-react": "^0.503.0",
    "next": "^15.5.15",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@playwright/test": "^1.59.1",
    "@poojly/tsconfig": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "happy-dom": "^20.10.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vercel": "^51.8.0",
    "wrangler": "^4.84.0"
  }
}

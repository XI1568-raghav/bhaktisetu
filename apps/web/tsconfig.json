{
  "extends": "@poojly/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@poojly/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@poojly/shared/*": [
        "../../packages/shared/src/*"
      ]
    },
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "lib/i18n/*.json",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "__tests__/**",
    "vitest.config.ts",
    "vitest.setup.ts"
  ]
}

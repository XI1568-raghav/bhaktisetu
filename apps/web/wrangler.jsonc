{
  // OpenNext (@opennextjs/cloudflare) worker config — migrated from wrangler.toml
  // (Pages) on 2026-07-07. Deploys to Cloudflare Workers (not Pages).
  // Ref: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "darshya",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-01-01",
  // nodejs_compat: Node.js runtime for the Next.js server (required by OpenNext).
  // global_fetch_strictly_public: blocks fetch() to internal Cloudflare addresses
  //   (security hardening; recommended by the adapter template).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Static assets served by the Workers Static Assets binding. `public/` files
  // (incl. _headers + _redirects) are copied here by opennextjs-cloudflare build.
  // run_worker_first: the worker runs before static-asset fallback for every
  //   request, so Next's headers()/redirects()/middleware + the ISR/SSR routes
  //   take precedence over raw static files.
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
    "run_worker_first": true
  },

  // Self-reference service binding — required by OpenNext's default incremental
  // cache (Workers Cache) for ISR/revalidate regeneration. The service name
  // MUST match the worker `name` above.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "darshya"
    }
  ],

  // Public env vars (non-secret). Mirrors the prior [vars] block in wrangler.toml.
  // NEXT_PUBLIC_* build-time vars are baked into the client bundle by `next build`
  // and do NOT need to appear here — only server-side runtime vars do.
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://api.darshya.online"
  },

  "observability": {
    "enabled": true
  }
}

# Cloudflare Workers static-assets redirect rules. Only real 3xx redirects belong here.
# Workers assets answers these BEFORE the Worker runs and does not support 200 rewrites,
# so the old Pages-era "/x /x 200" lines turned real routes into 404s. Every
# dynamic route (/pujas/[slug]/book, /yatra/[slug]/book, /astrology/[id], /store/[handle],
# /priest/bookings/[id], /admin/users/[id]) is a real Next route now; splat redirects
# to the old ?id= "view" pages would swallow their siblings and are removed.
# /og/puja/*, /og/temple/* and /og/shloka are real routes plus prerendered PNGs: not redirected.
/og/default          /logo.svg     302
# Legal/support URL aliases testers and old links use. The real routes are /refunds (footer + sitemap),
# /privacy, /terms, /shipping, /legal/cookies and /support/ticket/new. Answered by assets: no Worker CPU.
/refund-policy        /refunds              301
/refunds-policy       /refunds              301
/cancellation-policy  /refunds              301
/privacy-policy       /privacy              301
/terms-of-service     /terms                301
/terms-and-conditions /terms                301
/terms-conditions     /terms                301
/shipping-policy      /shipping             301
/cookie-policy        /legal/cookies        301
/support/tickets/new  /support/ticket/new   301

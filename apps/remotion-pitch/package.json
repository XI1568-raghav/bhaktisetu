{
  "name": "@poojly/remotion-pitch",
  "version": "0.0.0",
  "private": true,
  "description": "Darshya 60s investor pitch reel - Remotion composition",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build": "remotion render src/index.ts DarshyaPitch out/darshya-pitch.mp4 --concurrency=4",
    "build:fast": "remotion render src/index.ts DarshyaPitch out/darshya-pitch.mp4 --crf=23 --concurrency=8",
    "ship": "pnpm build && cp out/darshya-pitch.mp4 ../web/public/pitch/video/darshya-demo-reel.mp4 && echo '>>> shipped to apps/web/public/pitch/video/'"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.420",
    "@remotion/cli": "^4.0.420",
    "@remotion/renderer": "^4.0.420",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.420",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.8.3"
  }
}

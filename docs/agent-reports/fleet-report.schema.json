{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://darshya.online/schemas/fleet-report.json",
  "title": "Fleet agent report",
  "description": "Structured handoff schema for the 9-agent fleet. See docs/agent-reports/SCHEMA.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "agent", "runDate", "runTrigger", "summary", "findings"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "agent": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "runDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "runTrigger": {
      "type": "string",
      "enum": ["agents-daily", "agents-weekly", "manual", "pr-review", "health"]
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "detail"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
          "category": { "type": "string", "enum": ["lead", "bug", "security", "content", "metric", "task", "performance", "seo"] },
          "detail": { "type": "string", "minLength": 1 },
          "source": { "type": "string" },
          "evidence": { "type": "string" },
          "actionable": { "type": "boolean", "default": true }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url"],
        "properties": {
          "url": { "type": "string" },
          "type": { "type": "string" },
          "accessedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        }
      }
    },
    "nextActions": { "type": "array", "items": { "type": "string" } },
    "metrics": { "type": "object", "additionalProperties": true },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message"],
        "properties": {
          "message": { "type": "string" },
          "context": { "type": "string" }
        }
      }
    }
  }
}
